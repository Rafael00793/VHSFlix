# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ABYSS_API_KEY: Required for Abyss API calls.
ABYSS_API_KEY=

# TELEGRAM_BOT_TOKEN: Bot token for Telegram features.
TELEGRAM_BOT_TOKEN=

# YOUTUBE_API_KEY: Required for YouTube trailer searches.
YOUTUBE_API_KEY=

# ----------------------------------------------------
# NETLIFY & CLIENT-SIDE PRODUCTION CONFIGURATION (VITE_)
# Set these in your Netlify Environment Variables dashboard:
# ----------------------------------------------------
# VITE_API_URL: (Optional) URL of external backend server (e.g. https://my-backend.run.app)
VITE_API_URL=

# VITE_ABYSS_API_KEY: (Optional) Client-side Abyss API key for Netlify deployments
VITE_ABYSS_API_KEY=

# VITE_TMDB_API_KEY: (Optional) Client-side TMDb API key for Netlify deployments
VITE_TMDB_API_KEY=

# VITE_YOUTUBE_API_KEY: (Optional) Client-side YouTube API key for Netlify deployments
VITE_YOUTUBE_API_KEY=
